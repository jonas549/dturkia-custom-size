// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ReglaPersonalizada {
  id               String   @id @default(cuid())
  shop             String
  nombre           String
  minAncho         Int
  maxAncho         Int
  minAlto          Int
  maxAlto          Int
  precioPorM2      Float
  waterproofActivo Boolean  @default(true)
  waterproofPorM2  Float    @default(0)
  activa           Boolean  @default(true)
  productIds       String[] @default([])
  bordes           Json     @default("[]")
  /// Hasta 4 slots {url, nombre}. Mismo patrón que `bordes`, pero sin `tipo`.
  /// Se guardan los 4 slots tal cual (incluidos los vacíos); el filtrado de
  /// "slot completo" se hace al leer, como con bordes en /api/precio.
  tramas           Json     @default("[]")
  createdAt        DateTime @default(now())
  pliegos          Pliego[]
}

model PedidoCustom {
  id           String   @id @default(cuid())
  shop         String
  orderId      String
  ancho        Int
  alto         Int
  waterproof   Boolean  @default(false)
  precioTotal  Float
  estado       String   @default("pendiente")
  productTitle String   @default("")
  tipo         String   @default("medida")
  borde        String?
  /// Nombre de la trama elegida — snapshot, mismo tratamiento que `borde`.
  trama        String?
  createdAt    DateTime @default(now())

  // --- Stock por pliego (Fase 1) ---
  pliegoId     String?
  pliegoCodigo String   @default("") // snapshot — sobrevive si el pliego se da de baja
  rotada       Boolean  @default(false)
  orderName    String   @default("") // "#D1042" — cruza orden <-> pliego en el admin (decisión 5)
}

// ---------------------------------------------------------------------------
// Stock por pliego — ver BITACORA_STOCK_PLIEGOS_2026-08-12.md §4
// Todas las medidas en centímetros enteros (Int). Nunca metros con decimales:
// evita drift de float en las restas acumuladas. El admin muestra/pide metros
// y convierte en el borde.
// ---------------------------------------------------------------------------

/// Un pliego = un rollo físico individual. Ceniza = 11 filas.
model Pliego {
  id              String             @id @default(cuid())
  shop            String
  reglaId         String // = la trama
  regla           ReglaPersonalizada @relation(fields: [reglaId], references: [id], onDelete: Restrict)
  codigo          String // "CEN-400-01" — autogenerado, editable
  anchoCm         Int
  largoTotalCm    Int
  /// total − confirmado − ajustes. NO baja con las reservas: el stock se ocupa, no se resta.
  largoRestanteCm Int
  activo          Boolean            @default(true) // false = agotado / de baja / dañado
  nota            String             @default("")
  createdAt       DateTime           @default(now())
  reservas        ReservaPliego[]
  movimientos     MovimientoPliego[]

  @@unique([shop, codigo])
  @@index([shop, reglaId, activo, anchoCm]) // índice que usa el selector
}

/// Ocupación temporal del pliego. Una reserva 'pendiente' de más de 15 min
/// deja de ocupar sola: es una condición de tiempo en el WHERE, sin cron.
model ReservaPliego {
  id            String    @id @default(cuid())
  shop          String
  pliegoId      String
  /// Restrict: una reserva huérfana falsearía el cálculo de disponibilidad en silencio.
  pliego        Pliego    @relation(fields: [pliegoId], references: [id], onDelete: Restrict)
  reglaId       String
  refId         String    @unique // = id del item de localStorage → idempotencia
  largoCm       Int // lo que consume del pliego
  anchoPedidoCm Int
  altoPedidoCm  Int
  rotada        Boolean   @default(false)
  estado        String    @default("pendiente") // pendiente | confirmada | anulada
  draftOrderId  String?
  createdAt     DateTime  @default(now()) // + 15 min = vencimiento
  resueltaAt    DateTime?

  @@index([pliegoId, estado, createdAt]) // índice del cálculo de disponibilidad
}

/// Solo altas y ajustes manuales — auditoría. El consumo por venta vive en ReservaPliego.
model MovimientoPliego {
  id        String   @id @default(cuid())
  shop      String
  pliegoId  String
  /// Restrict: preserva la trazabilidad histórica de altas y ajustes.
  pliego    Pliego   @relation(fields: [pliegoId], references: [id], onDelete: Restrict)
  largoCm   Int
  motivo    String // 'alta' | 'ajuste' | 'baja'
  nota      String   @default("")
  createdAt DateTime @default(now())
}

model ReglaImpermeabilizador {
  id           String                      @id @default(cuid())
  shop         String
  productId    String
  productTitle String                      @default("")
  activa       Boolean                     @default(true)
  createdAt    DateTime                    @default(now())
  variantes    VarianteImpermeabilizador[]

  @@unique([shop, productId])
}

model VarianteImpermeabilizador {
  id           String                 @id @default(cuid())
  reglaId      String
  regla        ReglaImpermeabilizador @relation(fields: [reglaId], references: [id], onDelete: Cascade)
  variantId    String
  variantTitle String                 @default("")
  precio       Float
  aplica       Boolean                @default(true)

  @@unique([reglaId, variantId])
}

model ConfiguracionImpermeabilizador {
  id          String   @id @default(cuid())
  shop        String   @unique
  costoPorM2  Float    @default(13100)
  eyebrow     String   @default("CUIDADO · RECOMENDADO")
  titulo      String   @default("Impermeabiliza tu alfombra")
  descripcion String   @default("Protector Textil por sólo {precio}")
  disclaimer  String   @default("* Los plazos de entrega pueden ser desde 5 días hábiles")
  chipTexto   String   @default("AGREGAR")
  updatedAt   DateTime @updatedAt
}
