{% comment %}
  Custom Size Widget — autocontenido para temas OS 1.0
  Pegar en snippets/custom-size-snippet.liquid del tema (no de la extensión).
  No requiere App Blocks ni archivos externos.
{% endcomment %}

{% assign csw_shop    = shop.permanent_domain %}
{% assign csw_product = product.id | prepend: 'gid://shopify/Product/' %}

{%- assign csw_instant = false -%}
{%- for _t in product.tags -%}
  {%- assign _t_lower = _t | downcase -%}
  {%- if _t_lower == 'medida-personalizada' -%}
    {%- assign csw_instant = true -%}
  {%- endif -%}
{%- endfor -%}

{% if csw_instant %}
<script>document.documentElement.classList.add('csw-natives-hidden');</script>
<style>
  .csw-natives-hidden .product .right .price,
  .csw-natives-hidden #product-add,
  .csw-natives-hidden .product .right .remain {
    display: none !important;
  }
</style>
{% endif %}

<div id="csw-root"
     data-shop="{{ csw_shop }}"
     data-product-id="{{ csw_product }}"
     data-variant-id="{{ product.selected_or_first_available_variant.id }}"
     data-image-url="{{ product.featured_image | image_url: width: 400 }}"
     data-product-handle="{{ product.handle }}"
     {% unless csw_instant %}style="display:none"{% endunless %}>

  {% if csw_instant %}
  <div id="csw-loading">
    <div style="padding:32px 0;text-align:center;color:#9A9A9A;font-size:0.8125em;letter-spacing:0.5px">
      Cargando configurador&hellip;
    </div>
  </div>
  {% endif %}

  <div class="csw-container" {% if csw_instant %}style="display:none"{% endif %}>
    <p class="csw-modo-edicion-label">Editando medidas</p>
    <h3 class="csw-title">Medida Personalizada</h3>

    <div class="csw-slider-group">
      <label>Ancho: <span id="csw-ancho-val">--</span> cm</label>
      <input type="range" id="csw-ancho" min="0" max="100" step="1" value="50">
      <div class="csw-range-labels">
        <span id="csw-ancho-min"></span>
        <span id="csw-ancho-max"></span>
      </div>
    </div>

    <div class="csw-slider-group">
      <label>Alto: <span id="csw-alto-val">--</span> cm</label>
      <input type="range" id="csw-alto" min="0" max="100" step="1" value="50">
      <div class="csw-range-labels">
        <span id="csw-alto-min"></span>
        <span id="csw-alto-max"></span>
      </div>
    </div>

    <!-- Stock por pliego: aviso de medida no disponible / trama agotada.
         Va JUSTO DEBAJO DE LOS SLIDERS, que es donde el cliente está mirando
         mientras ajusta la medida. El JS además lo reubica aquí en tiempo de
         ejecución por si el markup del tema quedara en otro orden. -->
    <p id="csw-stock" class="csw-stock" style="display:none"></p>

    <!-- Impermeabilizador — Propuesta B; display toggled by JS -->
    <div id="csw-waterproof-section" style="display:none">
      <label id="csw-wf-label" class="csw-wf" for="csw-waterproof">
        <div class="csw-wf__head">
          <span class="csw-wf__eyebrow" id="csw-wf-eyebrow">CUIDADO &middot; RECOMENDADO</span>
          <span class="csw-wf__rule"></span>
        </div>
        <div class="csw-wf__body">
          <p class="csw-wf__title" id="csw-wf-titulo">Impermeabiliza tu alfombra</p>
          <p class="csw-wf__sub"><span id="csw-wf-before"></span><span id="csw-waterproof-precio" class="csw-wf__price">0</span><span id="csw-wf-after"></span></p>
        </div>
        <p class="csw-wf__disclaimer" id="csw-wf-disclaimer">* Los plazos de entrega pueden ser desde 5 d&iacute;as h&aacute;biles</p>
        <span class="csw-wf__action">
          <img src="https://cdn.shopify.com/s/files/1/0551/8970/0743/files/noun-drop-51984.png?v=1778267024" alt="" loading="lazy" width="34" style="width:34px;height:auto;display:block;flex-shrink:0;">
          <input type="checkbox" id="csw-waterproof">
          <span class="csw-wf__chip" id="csw-wf-chip">AGREGAR</span>
        </span>
      </label>
    </div>

    <div class="csw-resumen">
      <div>Alfombra: <strong id="csw-precio-alfombra">0</strong> CLP</div>
      <div id="csw-resumen-waterproof" style="display:none">Impermeabilizador: +<strong id="csw-precio-waterproof">0</strong> CLP</div>
      <div class="csw-total">Total: <strong id="csw-precio-total">0</strong> CLP</div>
    </div>

    <!-- ── Selectores ────────────────────────────────────────────────────────
         Trama arriba, borde abajo. En escritorio el JS los MUEVE a la columna
         izquierda (donde hoy está la imagen grande del producto); si por lo que
         sea no encuentra dónde moverlos, se quedan aquí y el widget sigue
         funcionando igual que antes. Ver `reubicarSelectores()`.
    --------------------------------------------------------------------------- -->

    <!-- Tramas — renderizadas por JS cuando data.tramas tiene ítems.
         Reutiliza las MISMAS clases csw-bordes-*/csw-b-* que los bordes: es el
         mismo diseño a propósito, así solo hay un sitio donde tocar estilos. -->
    <div id="csw-tramas-section" style="display:none">
      <div class="csw-bordes-head">
        <p class="csw-bordes-ttl">Selecciona una trama para poder calcular costos
          <small>Cada trama tiene su propio precio y sus propias medidas disponibles.</small></p>
        <span class="csw-bordes-sel" id="csw-trama-sel-label"></span>
      </div>
      <div class="csw-bordes-grid" id="csw-tramas-grid"></div>
    </div>

    <!-- Bordes decorativos — renderizados por JS cuando data.bordes tiene ítems -->
    <div id="csw-bordes-section" style="display:none">
      <div class="csw-bordes-head">
        <p class="csw-bordes-ttl">Elige el borde <small>Cinta decorativa que termina los cuatro lados de tu alfombra.</small></p>
        <span class="csw-bordes-sel" id="csw-borde-sel-label"></span>
      </div>
      <div class="csw-bordes-grid" id="csw-bordes-grid"></div>
    </div>

    <!-- Aviso de trama obligatoria. Va pegado al botón (no junto al selector,
         que en escritorio está en la OTRA columna) para que se entienda por qué
         el botón está deshabilitado. -->
    <p id="csw-trama-aviso" class="csw-stock" style="display:none"></p>

    <button id="csw-agregar" class="csw-btn" type="button">Agregar a la bolsa</button>
    <p id="csw-error" class="csw-error" style="display:none"></p>
  </div>

  {%- comment -%}
    Carrusel de imágenes del producto. Se imprime SOLO si el producto tiene
    imágenes: si no, no existe en el DOM y no hay nada que mostrar ni que ocultar.
    Nace oculto y dentro de #csw-root; el JS lo saca a ancho completo debajo de
    todo (`montarGaleria()`). Si el widget no llega a cargar, esto se queda
    oculto aquí dentro y la galería original del tema sigue intacta.
  {%- endcomment -%}
  {% if product.images.size > 0 %}
  <div id="csw-galeria" class="csw-galeria" style="display:none">
    <div class="swiper csw-galeria__swiper">
      <div class="swiper-wrapper">
        {% for image in product.images %}
          <div class="swiper-slide csw-galeria__slide">
            <img src="{{ image | image_url: width: 900 }}"
                 alt="{{ image.alt | escape }}" loading="lazy" />
          </div>
        {% endfor %}
      </div>
      <div class="csw-galeria__btn csw-galeria__prev" aria-label="Anterior"></div>
      <div class="csw-galeria__btn csw-galeria__next" aria-label="Siguiente"></div>
    </div>
  </div>
  {% endif %}
</div>

<style>
  #csw-root {
    margin: 24px 0;
    font-family: var(--font, 'Poppins', sans-serif);
  }

  .csw-container {
    border: 1px solid var(--crema, #E3DECC);
    padding: 20px 24px;
    background: var(--back, #F8F7F4);
    width: 100%;
    box-sizing: border-box;
  }

  .csw-modo-edicion-label {
    display: none;
    font-size: var(--f11, 0.6875em);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--dorado, #A59765);
    margin: 0 0 12px;
  }

  .csw-container.csw-modo-edicion {
    border-left: 3px solid var(--dorado, #A59765);
  }

  .csw-container.csw-modo-edicion .csw-modo-edicion-label {
    display: block;
  }

  .csw-title {
    margin: 0 0 20px;
    font-size: var(--f16, 1em);
    font-weight: 600;
    color: var(--color, #232930);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .csw-slider-group { margin-bottom: 20px; }

  .csw-slider-group label {
    display: block;
    font-size: var(--f13, 0.8125em);
    font-weight: 500;
    margin-bottom: 8px;
    color: var(--color, #232930);
    letter-spacing: 0.5px;
  }

  .csw-slider-group input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 3px;
    background: var(--crema, #E3DECC);
    outline: none;
    cursor: pointer;
  }

  .csw-slider-group input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--dorado, #A59765);
    cursor: pointer;
    border: 2px solid var(--blanco, #fff);
    box-shadow: 0 1px 4px rgba(0,0,0,.2);
    transition: var(--t025, all 0.25s ease-out);
  }

  .csw-slider-group input[type="range"]::-webkit-slider-thumb:hover {
    opacity: 0.8;
  }

  .csw-slider-group input[type="range"]::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--dorado, #A59765);
    cursor: pointer;
    border: 2px solid var(--blanco, #fff);
    box-shadow: 0 1px 4px rgba(0,0,0,.2);
  }

  .csw-range-labels {
    display: flex;
    justify-content: space-between;
    font-size: var(--f11, 0.6875em);
    color: var(--grisoscuro, #9A9A9A);
    margin-top: 5px;
    letter-spacing: 0.5px;
  }

  /* ── Impermeabilizador Propuesta B ───────────────────────────── */
  #csw-waterproof-section {
    margin-bottom: 20px;
  }

  .csw-wf {
    display: block;
    cursor: pointer;
    background: #F4F0E8;
    border: 1px solid #E3DCC9;
    border-left: 3px solid var(--dorado, #A59765);
    border-radius: 3px;
    padding: 18px 20px;
    position: relative;
    transition: background .2s ease, border-color .2s ease;
    box-sizing: border-box;
  }

  .csw-wf:hover { background: #EFEADD; }

  .csw-wf__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .csw-wf__eyebrow {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dorado, #A59765);
    font-weight: 600;
    white-space: nowrap;
  }

  .csw-wf__rule {
    flex: 1;
    height: 1px;
    background: #E3DCC9;
  }

  .csw-wf__title {
    font-size: var(--f16, 1em);
    font-weight: 500;
    color: var(--color, #232930);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .csw-wf__sub {
    font-size: var(--f13, 0.8125em);
    color: #5C5A54;
    margin: 0 0 8px;
    line-height: 1.5;
  }

  .csw-wf__price {
    font-weight: 600;
    color: var(--color, #232930);
  }

  .csw-wf__disclaimer {
    font-size: var(--f11, 0.6875em);
    color: #9A9A9A;
    margin: 10px 0 0;
    line-height: 1.5;
  }

  .csw-wf__action {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding: 9px 13px;
    background: #fff;
    border: 1px solid #E3DCC9;
    border-radius: 2px;
    transition: border-color .18s ease, background .18s ease;
    user-select: none;
    white-space: nowrap;
  }

  .csw-wf__chip {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color, #232930);
    transition: color .18s ease;
  }

  #csw-waterproof {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    margin: 0;
    border: 1.5px solid var(--dorado, #A59765);
    border-radius: 2px;
    background: #fff;
    cursor: pointer;
    position: relative;
    transition: background .18s ease;
    flex-shrink: 0;
  }

  #csw-waterproof:checked {
    background: var(--dorado, #A59765);
  }

  #csw-waterproof:checked::after {
    content: "";
    position: absolute;
    left: 6px;
    top: 2px;
    width: 5px;
    height: 10px;
    border: solid #fff;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }

  /* :has() checked state — progressively enhanced */
  .csw-wf:has(#csw-waterproof:checked) {
    background: #EFE8D2;
    border-color: var(--dorado, #A59765);
  }

  .csw-wf:has(#csw-waterproof:checked) .csw-wf__action {
    background: var(--dorado, #A59765);
    border-color: var(--dorado, #A59765);
  }

  .csw-wf:has(#csw-waterproof:checked) .csw-wf__chip {
    color: #fff;
  }

  .csw-wf:has(#csw-waterproof:checked) #csw-waterproof {
    background: #fff;
    border-color: #fff;
  }

  .csw-wf:has(#csw-waterproof:checked) #csw-waterproof::after {
    border-color: var(--dorado, #A59765);
  }

  /* JS fallback for browsers without :has() */
  .csw-wf.csw-wf--checked {
    background: #EFE8D2;
    border-color: var(--dorado, #A59765);
  }

  .csw-wf.csw-wf--checked .csw-wf__action {
    background: var(--dorado, #A59765);
    border-color: var(--dorado, #A59765);
  }

  .csw-wf.csw-wf--checked .csw-wf__chip {
    color: #fff;
  }

  .csw-wf.csw-wf--checked #csw-waterproof {
    background: #fff;
    border-color: #fff;
  }

  .csw-wf.csw-wf--checked #csw-waterproof::after {
    border-color: var(--dorado, #A59765);
  }

  /* ── Bordes decorativos ──────────────────────────────────────── */
  #csw-bordes-section {
    margin-bottom: 20px;
  }

  .csw-bordes-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--crema, #E3DECC);
  }

  .csw-bordes-ttl {
    font-size: var(--f14, 0.875em);
    font-weight: 500;
    color: var(--color, #232930);
    margin: 0;
  }

  .csw-bordes-ttl small {
    display: block;
    font-size: var(--f11, 0.6875em);
    color: var(--grisoscuro, #9A9A9A);
    font-weight: 400;
    margin-top: 3px;
    letter-spacing: 0.02em;
  }

  .csw-bordes-sel {
    font-size: var(--f11, 0.6875em);
    color: var(--grisoscuro, #9A9A9A);
    white-space: nowrap;
    margin-left: 12px;
    flex-shrink: 0;
  }

  .csw-bordes-sel b {
    color: var(--color, #232930);
    font-weight: 500;
  }

  .csw-bordes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .csw-b-card {
    position: relative;
    cursor: pointer;
    background: #fff;
    border: 1px solid var(--crema, #E3DECC);
    border-radius: 3px;
    overflow: hidden;
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    display: flex;
    flex-direction: column;
  }

  .csw-b-card:hover {
    transform: translateY(-2px);
    border-color: #C9C3B2;
    box-shadow: 0 6px 20px -10px rgba(35,41,48,.18);
  }

  .csw-b-thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    position: relative;
    background: var(--crema, #E3DECC);
  }

  .csw-b-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .csw-b-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(255,255,255,0.92);
    color: var(--color, #232930);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 5px 8px;
    border-radius: 2px;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity .25s ease, transform .25s ease;
  }

  .csw-b-meta {
    padding: 11px 12px 13px;
    border-top: 1px solid var(--crema, #E3DECC);
    transition: background .2s ease, border-color .2s ease;
  }

  .csw-b-meta .csw-b-nombre {
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grisoscuro, #9A9A9A);
    font-weight: 500;
    margin: 0 0 3px;
  }

  .csw-b-meta .csw-b-tipo {
    font-size: var(--f14, 0.875em);
    font-weight: 500;
    color: var(--color, #232930);
    margin: 0;
    transition: color .2s ease;
  }

  .csw-b-card.is-selected {
    border-color: var(--dorado, #A59765);
  }

  .csw-b-card.is-selected .csw-b-thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid var(--dorado, #A59765);
    pointer-events: none;
  }

  .csw-b-card.is-selected .csw-b-meta {
    background: #F4F0E8;
    border-top-color: var(--dorado, #A59765);
  }

  .csw-b-card.is-selected .csw-b-meta .csw-b-tipo {
    color: var(--dorado, #A59765);
  }

  .csw-b-card.is-selected .csw-b-badge {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Resumen ─────────────────────────────────────────────────── */
  .csw-resumen {
    background: var(--grisclaro, #f2f2f2);
    padding: 14px 16px;
    margin-bottom: 16px;
    font-size: var(--f13, 0.8125em);
    line-height: 2;
    color: var(--color, #232930);
  }

  .csw-resumen strong {
    color: var(--dorado, #A59765);
  }

  .csw-total {
    font-weight: 600;
    font-size: var(--f14, 0.875em);
    padding-top: 6px;
    border-top: 1px solid var(--crema, #E3DECC);
    margin-top: 4px;
  }

  .csw-total strong {
    font-size: var(--f16, 1em);
  }

  .csw-btn {
    display: block;
    width: 100%;
    padding: 16px 15px;
    background: var(--negro, #000000);
    color: var(--blanco, #ffffff);
    border: none;
    font-size: var(--f13, 0.8125em);
    font-weight: 600;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: var(--t025, all 0.25s ease-out);
  }

  .csw-btn:hover:not(:disabled) {
    opacity: 0.6;
  }

  .csw-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .csw-error {
    margin-top: 10px;
    font-size: var(--f12, 0.75em);
    color: var(--rojo, #d2451e);
    text-align: center;
  }

  /* Stock por pliego — aviso bajo los sliders.
     Va con #csw-root delante a propósito: el tema define
     `.product .description p { line-height:1.9em; padding-bottom:20px }`, que
     por especificidad le ganaría a una clase suelta y descuadraría la caja. */
  #csw-root .csw-stock {
    display: block;
    margin: 2px 0 20px;
    padding: 11px 14px;
    box-sizing: border-box;
    font-size: var(--f12, 0.75em);
    line-height: 1.45;
    text-align: left;
    color: var(--rojo, #d2451e);
    background: #fdf2ee;
    border: 1px solid rgba(210, 69, 30, 0.35);
    border-left-width: 3px;
  }

  #csw-root .csw-stock--agotado {
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* ── Selectores movidos a la columna izquierda ─────────────────────────────
     Al salir de `.csw-container` los selectores pierden su marco, así que se lo
     devolvemos aquí: cada bloque pasa a ser una tarjeta con el mismo fondo y
     borde que el contenedor del widget, tal como se ve en la maqueta.
     Estas reglas SOLO aplican cuando el JS los ha movido dentro de
     #csw-selectores; si el movimiento no ocurre, no se activan y los selectores
     siguen viéndose como hasta ahora dentro del widget. */
  #csw-selectores {
    margin: 0 0 24px;
    font-family: var(--font, 'Poppins', sans-serif);
  }

  #csw-selectores > div {
    border: 1px solid var(--crema, #E3DECC);
    background: var(--back, #F8F7F4);
    padding: 20px 24px;
    margin-bottom: 20px;
    box-sizing: border-box;
  }

  #csw-selectores > div:last-child { margin-bottom: 0; }

  /* Dentro de la tarjeta ya no hace falta el separador superior que llevaban
     cuando iban apilados dentro del widget. */
  #csw-selectores .csw-bordes-head { margin-top: 0; }

  /* ── Carrusel de imágenes del producto ─────────────────────────────────────
     Va a ancho completo debajo de las dos columnas. Las clases .swiper /
     .swiper-wrapper / .swiper-slide las exige Swiper 7 (ya cargado por el
     tema), pero el carrusel se monta FUERA de `.product`, así que las reglas
     del tema scopeadas a `.product .swiper-*` no lo alcanzan. */
  .csw-galeria {
    margin: 32px 0 40px;
    clear: both;
    width: 100%;
    box-sizing: border-box;
  }

  .csw-galeria__swiper {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .csw-galeria__slide {
    background: var(--crema, #E3DECC);
    overflow: hidden;
    height: auto;
  }

  .csw-galeria__slide img {
    width: 100%;
    aspect-ratio: 1 / 1;      /* misma razón que el fix de las miniaturas:
                                 sin esto las fotos verticales estiran el slide */
    object-fit: cover;
    display: block;
  }

  .csw-galeria__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    border: 1px solid var(--crema, #E3DECC);
    cursor: pointer;
    z-index: 2;
    transition: background .2s ease, opacity .2s ease;
  }

  .csw-galeria__btn:hover { background: #fff; }

  /* Swiper marca los botones con esta clase cuando no hay a dónde ir */
  .csw-galeria__btn.swiper-button-disabled { opacity: .35; cursor: default; }

  .csw-galeria__btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-top: 1.5px solid var(--color, #232930);
    border-right: 1.5px solid var(--color, #232930);
  }

  .csw-galeria__next::after { transform: translate(-65%, -50%) rotate(45deg); }
  .csw-galeria__prev::after { transform: translate(-35%, -50%) rotate(-135deg); }

  .csw-galeria__prev { left: 12px; }
  .csw-galeria__next { right: 12px; }

  @media (max-width: 480px) {
    .csw-container { padding: 16px; }

    .csw-wf__action {
      display: flex;
      width: 100%;
      justify-content: space-between;
      box-sizing: border-box;
    }

    /* Bordes: horizontal cards on mobile */
    .csw-bordes-grid {
      grid-template-columns: 1fr;
    }

    .csw-b-card {
      flex-direction: row;
    }

    /* 🐛 FIX MÓVIL (2026-08-14). Antes aquí había `aspect-ratio: unset`, y esa
       era la causa de que las miniaturas salieran estiradas hacia abajo: sin
       proporción declarada, `.csw-b-thumb` no tiene altura propia, así que
       `.csw-b-thumb img { height: 100% }` se resuelve como `auto` y la imagen
       se pinta con SU proporción natural. Como las fotos de alfombra son muy
       verticales (1:3 y más), la tarjeta crecía hasta ~540 px de alto.
       Ahora la miniatura declara su proporción también en móvil, el alto queda
       acotado y `object-fit: cover` recorta en vez de deformar. */
    .csw-b-thumb {
      aspect-ratio: 1 / 1;
      width: 96px;
      flex-shrink: 0;
      align-self: flex-start;   /* que el stretch del flex no la vuelva a estirar */
    }

    .csw-b-meta {
      flex: 1;
      border-top: none;
      border-left: 1px solid var(--crema, #E3DECC);
    }

    .csw-b-card.is-selected .csw-b-meta {
      border-left-color: var(--dorado, #A59765);
    }

    .csw-b-badge {
      top: 7px;
      left: 7px;
      padding: 4px 6px;
      font-size: 8px;
    }
  }
</style>

<script>
(function () {
  'use strict';

  /* ─── VERSIÓN DEL SNIPPET ──────────────────────────────────────────────────
     El tema no está en git y se copia a mano: sin esto no hay forma de saber
     desde fuera qué versión está viva. Si esta línea NO sale en la consola de
     la página de producto, el archivo pegado en el editor de temas NO es éste.
     Ya pasó una vez (2026-08-13): la tienda seguía sirviendo la versión
     anterior y el widget validaba con la regla vieja, permitiendo medidas
     imposibles.
  --------------------------------------------------------------------------- */
  var CSW_VERSION = '2026-08-14c-stock-y-precio-por-trama';
  console.log('%c[CSW] snippet ' + CSW_VERSION,
              'background:#111;color:#7CFC00;padding:2px 8px;border-radius:3px;font-weight:bold');

  var APP_URL = 'https://dturkia-custom-size.vercel.app';

  var fmt = new Intl.NumberFormat('es-CL', { style: 'decimal', maximumFractionDigits: 0 });

  function eid(id) { return document.getElementById(id); }

  function mostrarNativos() {
    document.documentElement.classList.remove('csw-natives-hidden');
  }

  /* ─── Stock por pliego — EL ESCALÓN LO FIJA EL ANCHO PEDIDO ────────────────
     Cada ancho de rollo que existe en la trama define un ESCALÓN. Lo PRIMERO
     que se calcula, y lo único que decide en qué rollos se busca, es:

         escalon = el PRIMER ancho de rollo >= AL ANCHO QUE PIDIÓ EL CLIENTE

     Toda la validación ocurre dentro de ese escalón. Un escalón sin material NO
     toma prestado del de arriba: con anchos {100, 300, 400} y los rollos de 300
     secos, un pedido de 228 cm de ancho se BLOQUEA aunque los de 400 estén
     llenos, y se bloquea con cualquier alto.

     🔶 CORRECCIÓN 2026-08-14 — LA ROTACIÓN NO CAMBIA DE ESCALÓN. Antes cada
     orientación calculaba su propio escalón (la rotada, sobre el alto), y por
     ahí se colaba 228×320: girada pasaba a ser 320 de ancho, escalón 400, con
     material. Eso vendía material de 400 a quien pidió 228 de ancho. Ahora la
     rotación solo sirve para resolver el LARGO dentro del escalón del ancho
     pedido:
       · normal → el ancho va a lo ancho del rollo, consume `alto` de largo.
       · rotada → el alto va a lo ancho del rollo (exige alto <= escalon) y
                  consume `ancho` de largo.

     Consecuencia buscada: la regla es ASIMÉTRICA. 228×320 se bloquea y 320×228
     se permite, porque son pedidos distintos — el cliente pide un ancho.

     `capacidades` llega de /api/precio como [{anchoCm, largoMaxCm}] y es LA
     ESCALERA de anchos de rollo, no "lo vendible": los anchos sin material
     viajan con largoMaxCm 0 porque hacen falta para calcular el escalón.
       · undefined                  → la trama no tiene pliegos cargados → SIN
                                      control de stock, el widget se comporta
                                      exactamente como antes.
       · ningún largoMaxCm > 0      → no queda material → AGOTADO.
       · con material               → se valida el par en cada movimiento.

     ⚠️ Esta lógica es la MISMA que `evaluar()` de app/lib/pliegos.server.ts. Si
     se cambia una, hay que cambiar la otra o el widget y el checkout se
     contradicen. Aun así el checkout revalida siempre: el frontend nunca es
     autoridad sobre el stock.
  --------------------------------------------------------------------------- */
  function escalonPara(medidaCm, capacidades) {
    var mejor = null;
    for (var i = 0; i < capacidades.length; i++) {
      var c = capacidades[i];
      if (c.anchoCm >= medidaCm && (mejor === null || c.anchoCm < mejor.anchoCm)) mejor = c;
    }
    return mejor;   /* null = no existe ningún ancho de rollo >= a la medida */
  }

  function hayMaterial(capacidades) {
    if (!capacidades) return false;
    for (var i = 0; i < capacidades.length; i++) {
      if (capacidades[i].largoMaxCm > 0) return true;
    }
    return false;
  }

  /* Espejo de `evaluar()` del backend: devuelve el veredicto Y el motivo. */
  function evaluarMedida(anchoCm, altoCm, capacidades) {
    var esc = escalonPara(anchoCm, capacidades);

    if (!esc) {
      return { escalonCm: null, largoMaxCm: 0, permite: false, orientacion: null,
               motivo: 'no existe ningún rollo de ancho >= ' + anchoCm + ' cm' };
    }
    if (esc.largoMaxCm <= 0) {
      return { escalonCm: esc.anchoCm, largoMaxCm: 0, permite: false, orientacion: null,
               motivo: 'el escalón ' + esc.anchoCm + ' cm (el del ancho pedido ' + anchoCm +
                       ') está AGOTADO; no se salta al escalón de arriba' };
    }
    /* Normal: el ancho ya cabe a lo ancho del rollo por definición de escalón. */
    if (esc.largoMaxCm >= altoCm) {
      return { escalonCm: esc.anchoCm, largoMaxCm: esc.largoMaxCm, permite: true, orientacion: 'normal',
               motivo: 'normal en el escalón ' + esc.anchoCm + ': consume ' + altoCm +
                       ' de largo y hay ' + esc.largoMaxCm };
    }
    /* Rotada: solo si el alto también cabe a lo ancho de ESTE mismo rollo. */
    if (altoCm <= esc.anchoCm && esc.largoMaxCm >= anchoCm) {
      return { escalonCm: esc.anchoCm, largoMaxCm: esc.largoMaxCm, permite: true, orientacion: 'rotada',
               motivo: 'rotada dentro del escalón ' + esc.anchoCm + ': el alto ' + altoCm +
                       ' cabe a lo ancho del rollo y consume ' + anchoCm + ' de largo' };
    }
    var porQueNo = altoCm > esc.anchoCm
      ? 'el alto ' + altoCm + ' no cabe a lo ancho del rollo de ' + esc.anchoCm
      : 'girada consumiría ' + anchoCm + ' de largo';
    return { escalonCm: esc.anchoCm, largoMaxCm: esc.largoMaxCm, permite: false, orientacion: null,
             motivo: 'escalón ' + esc.anchoCm + ' con solo ' + esc.largoMaxCm +
                     ' de largo: normal necesita ' + altoCm + ' y ' + porQueNo };
  }

  function cabeEnCapacidades(anchoCm, altoCm, capacidades) {
    if (!capacidades || !capacidades.length) {
      console.log('[CSW] validando ' + anchoCm + 'x' + altoCm + ' => sin escalera de capacidades');
      return false;
    }

    var v = evaluarMedida(anchoCm, altoCm, capacidades);

    /* Un solo log con TODO lo que hace falta para auditar la decisión: qué
       escalón salió del ANCHO pedido, cuánto largo hay en ese escalón, y por
       qué permite o bloquea. Si esto no aparece al mover el slider, es que la
       validación no se está ejecutando (o el snippet pegado no es éste). */
    console.log(
      '[CSW] validando ' + anchoCm + 'x' + altoCm +
      ' | escalón(ancho ' + anchoCm + ') = rollo ' + (v.escalonCm === null ? '—' : v.escalonCm) +
      ' | largo disponible en ese escalón = ' + v.largoMaxCm +
      ' | ' + (v.permite ? 'PERMITE (' + v.orientacion + ')' : 'BLOQUEA') +
      ' → ' + v.motivo,
    );

    return v.permite;
  }

  /* El aviso tiene que salir DEBAJO DE LOS SLIDERS, que es donde el cliente
     está mirando mientras ajusta la medida — no pegado al botón, que puede
     quedar fuera de pantalla. Se reubica en tiempo de ejecución en vez de
     confiar en el orden del markup: si el snippet del tema quedó con otra
     disposición, esto lo corrige igual. Se hace una sola vez. */
  var stockReubicado = false;
  function colocarAvisoStock() {
    if (stockReubicado) return;
    var el = eid('csw-stock');
    var alto = eid('csw-alto');
    if (!el || !alto) return;
    var grupo = alto.parentNode;                 /* .csw-slider-group del alto */
    if (grupo && grupo.parentNode) {
      grupo.parentNode.insertBefore(el, grupo.nextSibling);
      stockReubicado = true;
    }
  }

  function mostrarStock(msg, esAgotado) {
    var el = eid('csw-stock');
    if (!el) return;
    colocarAvisoStock();
    if (!msg) { el.style.display = 'none'; el.textContent = ''; return; }
    el.textContent = msg;
    el.className = 'csw-stock' + (esAgotado ? ' csw-stock--agotado' : '');
    el.style.display = '';
  }

  function mostrarError(msg) {
    var el = eid('csw-error');
    if (!el) return;
    el.textContent = msg;
    el.style.display = msg ? '' : 'none';
  }

  /* Fórmula original preservada: m²Alfombra con techo, m²Real exacto para waterproof */
  function calcular(precioPorM2, waterproofPorM2, waterproofActivo) {
    var ancho = parseInt(eid('csw-ancho').value, 10);
    var alto  = parseInt(eid('csw-alto').value,  10);
    var m2Alfombra       = Math.ceil(ancho / 100) * Math.ceil(alto / 100);
    var m2Real           = (ancho / 100) * (alto / 100);

    var precioAlfombra   = Math.round(m2Alfombra * precioPorM2);
    var precioWaterproof = Math.floor(m2Real * waterproofPorM2);
    var wpChecked = waterproofActivo && eid('csw-waterproof') && eid('csw-waterproof').checked;

    eid('csw-precio-alfombra').textContent = fmt.format(precioAlfombra);

    if (waterproofActivo) {
      eid('csw-waterproof-precio').textContent  = fmt.format(precioWaterproof);
      eid('csw-precio-waterproof').textContent  = fmt.format(precioWaterproof);
      eid('csw-resumen-waterproof').style.display = wpChecked ? '' : 'none';
    }

    var total = precioAlfombra + (wpChecked ? precioWaterproof : 0);
    eid('csw-precio-total').textContent = fmt.format(total);
  }

  /* ── Bordes ─────────────────────────────────────────────────── */
  var bordeSeleccionado = null;

  function renderBordes(bordes, preselect) {
    if (!bordes || !bordes.length) return;

    var section = eid('csw-bordes-section');
    var grid    = eid('csw-bordes-grid');
    var selLbl  = eid('csw-borde-sel-label');
    if (!section || !grid) return;

    if (bordes.length === 4) {
      grid.style.gridTemplateColumns = 'repeat(2, 1fr)';
    }

    bordes.forEach(function(borde) {
      var key  = borde.nombre + ' - ' + borde.tipo;
      var card = document.createElement('div');
      card.className = 'csw-b-card';
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');
      card.setAttribute('aria-label', borde.nombre + ' ' + borde.tipo);

      var thumb = document.createElement('div');
      thumb.className = 'csw-b-thumb';

      var img = document.createElement('img');
      img.src = borde.imagenUrl;
      img.alt = borde.nombre + ' ' + borde.tipo;
      img.onerror = function() { this.style.display = 'none'; };

      var badge = document.createElement('span');
      badge.className = 'csw-b-badge';
      badge.textContent = 'Seleccionado';

      thumb.appendChild(img);
      thumb.appendChild(badge);

      var meta = document.createElement('div');
      meta.className = 'csw-b-meta';

      var elNombre = document.createElement('p');
      elNombre.className = 'csw-b-nombre';
      elNombre.textContent = borde.nombre;

      var elTipo = document.createElement('p');
      elTipo.className = 'csw-b-tipo';
      elTipo.textContent = borde.tipo;

      meta.appendChild(elNombre);
      meta.appendChild(elTipo);
      card.appendChild(thumb);
      card.appendChild(meta);

      if (preselect && preselect === key) {
        card.classList.add('is-selected');
        bordeSeleccionado = { nombre: borde.nombre, tipo: borde.tipo };
        if (selLbl) selLbl.innerHTML = 'Seleccionado: <b>' + borde.tipo + '</b>';
      }

      function seleccionar() {
        grid.querySelectorAll('.csw-b-card').forEach(function(c) { c.classList.remove('is-selected'); });
        card.classList.add('is-selected');
        bordeSeleccionado = { nombre: borde.nombre, tipo: borde.tipo };
        if (selLbl) selLbl.innerHTML = 'Seleccionado: <b>' + borde.tipo + '</b>';
      }

      card.addEventListener('click', seleccionar);
      card.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); seleccionar(); }
      });

      grid.appendChild(card);
    });

    section.style.display = '';
  }

  /* ── Tramas ───────────────────────────────────────────────────────────────
     🔷 STOCK Y PRECIO POR TRAMA (§4.4). Una trama ya no es solo una foto con un
     nombre: es la unidad que decide TRES cosas a la vez, y por eso no se puede
     calcular nada hasta que el cliente elija una.

       · su PRECIO por m²        → `calcular()` recibe el de la trama elegida
       · sus TOPES de slider     → min(tope comercial, lo que dan sus rollos)
       · su ESCALERA de stock    → qué medidas son vendibles

     De ahí el flujo: sin trama elegida los sliders están BLOQUEADOS y no hay
     precio; al elegir una se habilitan, se aplican sus topes (con clamp del
     valor actual al nuevo rango) y se valida el stock contra SUS rollos.

     Cada tarjeta guarda su trama entera en el closure, así que cambiar de trama
     NO hace otra llamada a /api/precio: todo vino en la primera respuesta.

     Si la regla trae UNA SOLA trama se auto-selecciona al cargar, para no
     obligar a un clic que no decide nada.
  --------------------------------------------------------------------------- */
  var tramaSeleccionada = null;
  var tramaRequerida    = false;   /* solo si la regla trae al menos 1 trama */
  var alCambiarTrama    = null;    /* lo engancha init() para refrescar todo */

  function renderTramas(tramas, preselect) {
    if (!tramas || !tramas.length) return;

    var section = eid('csw-tramas-section');
    var grid    = eid('csw-tramas-grid');
    var selLbl  = eid('csw-trama-sel-label');
    if (!section || !grid) return;

    tramaRequerida = true;

    if (tramas.length === 4) {
      grid.style.gridTemplateColumns = 'repeat(2, 1fr)';
    }

    var primeraTarjeta = null;

    tramas.forEach(function(trama) {
      var card = document.createElement('div');
      card.className = 'csw-b-card';
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');
      card.setAttribute('aria-label', trama.nombre);

      var thumb = document.createElement('div');
      thumb.className = 'csw-b-thumb';

      var img = document.createElement('img');
      img.src = trama.url;
      img.alt = trama.nombre;
      img.onerror = function() { this.style.display = 'none'; };

      var badge = document.createElement('span');
      badge.className = 'csw-b-badge';
      badge.textContent = 'Seleccionado';

      thumb.appendChild(img);
      thumb.appendChild(badge);

      var meta = document.createElement('div');
      meta.className = 'csw-b-meta';

      var elNombre = document.createElement('p');
      elNombre.className = 'csw-b-tipo';   /* el renglón destacado */
      elNombre.textContent = trama.nombre;
      meta.appendChild(elNombre);

      /* Una trama puede estar agotada mientras su hermana no lo está, así que
         se marca en la propia tarjeta: es la única forma de que el cliente
         entienda por qué esa sí y esa no. Se puede seleccionar igual — al
         hacerlo sale el aviso con el nombre. */
      if (trama.agotada) {
        var elAgot = document.createElement('p');
        elAgot.className = 'csw-b-nombre';
        elAgot.textContent = 'Agotada';
        elAgot.style.color = '#8f1c1c';
        elAgot.style.fontWeight = '600';
        meta.appendChild(elAgot);
        card.classList.add('csw-b-card--agotada');
        card.style.opacity = '0.65';
      }

      card.appendChild(thumb);
      card.appendChild(meta);

      function marcar() {
        grid.querySelectorAll('.csw-b-card').forEach(function(c) { c.classList.remove('is-selected'); });
        card.classList.add('is-selected');
        /* Se guarda la trama ENTERA: de aquí salen el precio, los topes y la
           escalera de stock que usa el resto del widget. */
        tramaSeleccionada = trama;
        if (selLbl) selLbl.innerHTML = 'Seleccionada: <b>' + trama.nombre + '</b>';
      }

      function seleccionar() {
        marcar();
        if (alCambiarTrama) alCambiarTrama();
      }

      card.addEventListener('click', seleccionar);
      card.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); seleccionar(); }
      });

      if (!primeraTarjeta) primeraTarjeta = seleccionar;
      if (preselect && preselect === trama.nombre) card.dataset.cswPreselect = '1';

      grid.appendChild(card);
    });

    section.style.display = '';

    /* Preselección (modo edición) y auto-selección con una sola trama. Las dos
       pasan por `seleccionar()` para que apliquen precio y topes, no solo el
       resaltado de la tarjeta. */
    var preCard = preselect ? grid.querySelector('[data-csw-preselect="1"]') : null;
    if (preCard) {
      preCard.click();
    } else if (tramas.length === 1 && primeraTarjeta) {
      console.log('[CSW] la regla tiene UNA sola trama → auto-seleccionada:', tramas[0].nombre);
      primeraTarjeta();
    }
  }

  /* ── Reubicación del layout (Fase 3) ──────────────────────────────────────
     Los selectores nacen dentro del widget, en la columna DERECHA, porque el
     snippet se renderiza desde `product-add.liquid`. Aquí se mueven a la
     columna izquierda del tema y se oculta la galería grande que había ahí.

     ⚠️ La galería se OCULTA, nunca se elimina: `product-add.liquid` hace
     `document.querySelector('.mySwiper2').swiper` en tres sitios al cambiar de
     variante, y si el nodo desapareciera reventaría el cambio de variante.

     Todo va con guardas: si el tema no tiene `.left` o `.gal`, no se mueve nada
     y el widget se queda como estaba. Nunca debe romper la página.
  --------------------------------------------------------------------------- */
  function reubicarSelectores() {
    var izquierda = document.getElementById('left-temp') ||
                    document.querySelector('.product > .left');
    if (!izquierda) {
      console.log('[CSW] no se encontró la columna izquierda → los selectores se quedan en el widget');
      return false;
    }

    var secciones = [eid('csw-tramas-section'), eid('csw-bordes-section')].filter(Boolean);
    if (!secciones.length) return false;

    var cont = document.createElement('div');
    cont.id = 'csw-selectores';
    izquierda.insertBefore(cont, izquierda.firstChild);
    secciones.forEach(function(s) { cont.appendChild(s); });   /* appendChild MUEVE el nodo */

    /* La imagen grande + las miniaturas verticales dejan de mostrarse. */
    var gal = izquierda.querySelector('.gal');
    if (gal) gal.style.display = 'none';

    console.log('[CSW] selectores movidos a la columna izquierda; galería original oculta');
    return true;
  }

  /* Saca el carrusel a ancho completo, justo DEBAJO de las dos columnas.
     Se inserta como hermano de `.product` para que las reglas del tema
     scopeadas a `.product ...` no lo toquen. */
  function montarGaleria() {
    var gal = eid('csw-galeria');
    if (!gal) {          /* el producto no tiene imágenes → no se pinta nada */
      console.log('[CSW] el producto no tiene imágenes → sin carrusel');
      return;
    }

    var prod = document.querySelector('.product');
    if (prod && prod.parentNode) {
      prod.parentNode.insertBefore(gal, prod.nextSibling);
    }
    gal.style.display = '';

    var slides = gal.querySelectorAll('.swiper-slide').length;

    /* Swiper 7 lo carga el tema con `defer`, así que puede no estar listo
       todavía. Se reintenta un rato y, si nunca llega, el carrusel se queda
       como una fila de imágenes con scroll horizontal (degradado digno). */
    var intentos = 0;
    (function initSwiper() {
      if (typeof Swiper === 'undefined') {
        if (++intentos > 40) {
          gal.querySelector('.swiper-wrapper').style.cssText =
            'display:flex;gap:10px;overflow-x:auto;';
          console.log('[CSW] Swiper no llegó a cargar → carrusel degradado a scroll horizontal');
          return;
        }
        return setTimeout(initSwiper, 100);
      }
      new Swiper(gal.querySelector('.csw-galeria__swiper'), {
        spaceBetween: 10,
        slidesPerView: 1.15,
        /* Sin loop cuando hay pocas fotos: con loop y 1 sola imagen Swiper
           duplica slides y se ve raro (ya pasó con el slideshow del tema). */
        loop: false,
        watchOverflow: true,
        navigation: { nextEl: '.csw-galeria__next', prevEl: '.csw-galeria__prev' },
        breakpoints: {
          640:  { slidesPerView: 2.2, spaceBetween: 12 },
          830:  { slidesPerView: 3,   spaceBetween: 14 },
          1200: { slidesPerView: 4,   spaceBetween: 16 }
        }
      });
      console.log('[CSW] carrusel montado con ' + slides + ' imagen(es)');
    })();
  }

  function init() {
    var root = document.getElementById('csw-root');
    if (!root) return;

    var shop      = root.dataset.shop;
    var productId = root.dataset.productId;
    if (!shop) return;

    var urlParams     = new URLSearchParams(window.location.search);
    var editId        = urlParams.get('csw_edit') || '';
    var editAncho     = editId ? parseInt(urlParams.get('ancho') || '0', 10) : 0;
    var editAlto      = editId ? parseInt(urlParams.get('alto')  || '0', 10) : 0;
    var editWp        = editId ? urlParams.get('waterproof') === '1' : false;
    var enModoEdicion = !!editId;

    /* Recuperar borde del item siendo editado */
    var editBorde = '';
    var editTrama = '';
    if (enModoEdicion) {
      try {
        var rawEx = localStorage.getItem('csw_pending_orders');
        if (rawEx) {
          var exArr = JSON.parse(rawEx);
          var exItem = exArr.find(function(i) { return i.id === editId; });
          if (exItem && exItem.borde) editBorde = exItem.borde;
          if (exItem && exItem.trama) editTrama = exItem.trama;
        }
      } catch (e) {}
    }

    var safetyFired = false;
    var safetyTimer = setTimeout(function() {
      safetyFired = true;
      root.style.display = 'none';
      mostrarNativos();
    }, 8000);

    var apiUrl = APP_URL + '/api/precio'
      + '?shop='   + encodeURIComponent(shop)
      + '&ancho=100'
      + '&alto=100'
      + (productId ? '&productId=' + encodeURIComponent(productId) : '');

    fetch(apiUrl)
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        clearTimeout(safetyTimer);
        if (safetyFired) return;

        var loadingEl   = eid('csw-loading');
        var containerEl = root.querySelector('.csw-container');

        if (!data || data.error) {
          root.style.display = 'none';
          mostrarNativos();
          return;
        }

        var regla            = data.regla;
        var waterproofPorM2  = data.waterproofPorM2 || 0;
        var waterproofActivo = !!data.waterproofActivo;

        /* 🔷 §4.4 — TODO lo que depende de la trama vive en estas variables, y
           las tres se rellenan al elegir trama (o quedan neutras si la regla no
           tiene tramas). Antes salían de la regla y eran constantes. */
        var precioPorM2    = 0;      /* precio/m² de la trama elegida */
        var capacidades    = undefined; /* escalera de la trama elegida */
        var controlDeStock = false;  /* false = esa trama no tiene rollos */
        var tramaAgotada   = false;  /* ningún escalón de ESA trama con material */

        var reglaId  = data.reglaId || '';
        var tramas   = Array.isArray(data.tramas) ? data.tramas : [];

        /* Sin tramas la regla se comporta EXACTAMENTE como antes de este
           cambio: precio de la regla, topes de la regla, sin control de stock.
           Es el caso de los productos que nunca usaron tramas. */
        var sinTramas = tramas.length === 0;
        if (sinTramas) {
          precioPorM2 = data.precioPorM2 || 0;
          console.log('[CSW] esta regla no tiene tramas → precio y topes de la regla, sin control ' +
                      'de stock (comportamiento de siempre)');
        } else {
          console.log('[CSW] ' + tramas.length + ' trama(s):', tramas.map(function (t) {
            return t.nombre + ' (' + t.precioPorM2 + '/m², ' +
                   (t.capacidades ? (t.agotada ? 'AGOTADA' : t.capacidades.length + ' escalones') : 'sin rollos') + ')';
          }).join('  ·  '));
        }

        var sAncho   = eid('csw-ancho');
        var sAlto    = eid('csw-alto');
        var midAncho = Math.round((regla.minAncho + regla.maxAncho) / 2);
        var midAlto  = Math.round((regla.minAlto  + regla.maxAlto)  / 2);

        sAncho.min = regla.minAncho; sAncho.max = regla.maxAncho; sAncho.value = midAncho;
        sAlto.min  = regla.minAlto;  sAlto.max  = regla.maxAlto;  sAlto.value  = midAlto;

        eid('csw-ancho-val').textContent = midAncho;
        eid('csw-alto-val').textContent  = midAlto;
        eid('csw-ancho-min').textContent = regla.minAncho + ' cm';
        eid('csw-ancho-max').textContent = regla.maxAncho + ' cm';
        eid('csw-alto-min').textContent  = regla.minAlto  + ' cm';
        eid('csw-alto-max').textContent  = regla.maxAlto  + ' cm';

        /* 🔷 Los topes son POR TRAMA: el rollo más ancho con material de una
           trama no tiene por qué ser el de la otra. Al cambiar de trama se
           reaplican y el valor actual se mete a la fuerza dentro del nuevo
           rango (clamp), porque si no el slider se queda con un número que ya
           no puede representar. */
        function aplicarTopes(t) {
          var r = (t && t.regla) ? t.regla : regla;
          var nAncho = Math.min(Math.max(parseInt(sAncho.value, 10) || r.minAncho, r.minAncho), r.maxAncho);
          var nAlto  = Math.min(Math.max(parseInt(sAlto.value,  10) || r.minAlto,  r.minAlto),  r.maxAlto);

          sAncho.min = r.minAncho; sAncho.max = r.maxAncho; sAncho.value = nAncho;
          sAlto.min  = r.minAlto;  sAlto.max  = r.maxAlto;  sAlto.value  = nAlto;

          eid('csw-ancho-val').textContent = nAncho;
          eid('csw-alto-val').textContent  = nAlto;
          eid('csw-ancho-min').textContent = r.minAncho + ' cm';
          eid('csw-ancho-max').textContent = r.maxAncho + ' cm';
          eid('csw-alto-min').textContent  = r.minAlto  + ' cm';
          eid('csw-alto-max').textContent  = r.maxAlto  + ' cm';
        }

        /* Sin trama elegida los sliders no se pueden tocar y no hay precio: el
           precio y las medidas vendibles DEPENDEN de la trama, así que enseñar
           un número antes de elegirla sería enseñar un número inventado. */
        function bloquearSliders(bloqueado) {
          sAncho.disabled = bloqueado;
          sAlto.disabled  = bloqueado;
          var op = bloqueado ? '0.45' : '';
          var grupos = root.querySelectorAll('.csw-slider-group');
          for (var i = 0; i < grupos.length; i++) {
            grupos[i].style.opacity = op;
            grupos[i].style.pointerEvents = bloqueado ? 'none' : '';
          }
          var resumen = root.querySelector('.csw-resumen');
          if (resumen) resumen.style.display = bloqueado ? 'none' : '';
        }

        if (enModoEdicion) {
          if (editAncho >= parseInt(regla.minAncho) && editAncho <= parseInt(regla.maxAncho)) {
            sAncho.value = editAncho;
            eid('csw-ancho-val').textContent = editAncho;
          }
          if (editAlto >= parseInt(regla.minAlto) && editAlto <= parseInt(regla.maxAlto)) {
            sAlto.value = editAlto;
            eid('csw-alto-val').textContent = editAlto;
          }
        }

        /* Aplicar textos del impermeabilizador desde API */
        var imp        = data.textosImp || {};
        var eyebrow    = imp.eyebrow     || 'CUIDADO · RECOMENDADO';
        var titulo     = imp.titulo      || 'Impermeabiliza tu alfombra';
        var descripcion= imp.descripcion || 'Protector Textil por sólo {precio}';
        var disclaimer = imp.disclaimer  || '* Los plazos de entrega pueden ser desde 5 días hábiles';
        var chipTexto  = imp.chipTexto   || 'AGREGAR';

        if (eid('csw-wf-eyebrow'))    eid('csw-wf-eyebrow').textContent    = eyebrow;
        if (eid('csw-wf-titulo'))     eid('csw-wf-titulo').textContent     = titulo;
        if (eid('csw-wf-disclaimer')) eid('csw-wf-disclaimer').textContent = disclaimer;
        if (eid('csw-wf-chip'))       eid('csw-wf-chip').textContent       = chipTexto;

        /* Interpolar {precio} en la descripción */
        var parts = descripcion.split('{precio}');
        if (eid('csw-wf-before')) eid('csw-wf-before').textContent = parts[0] || '';
        if (eid('csw-wf-after'))  eid('csw-wf-after').textContent  = parts[1] || '';
        if (eid('csw-waterproof-precio') && parts.length < 2) {
          eid('csw-waterproof-precio').style.display = 'none';
        }

        if (waterproofActivo) {
          eid('csw-waterproof-section').style.display = '';
          if (enModoEdicion && editWp && eid('csw-waterproof')) {
            eid('csw-waterproof').checked = true;
            var wfLbl = eid('csw-wf-label');
            if (wfLbl) wfLbl.classList.add('csw-wf--checked');
          }
        }

        /* Stock por pliego (Fase 6): valida el PAR y habilita/deshabilita el
           botón. 🔷 Ahora contra la escalera de LA TRAMA ELEGIDA. */
        function revisarDisponibilidad() {
          var btn = eid('csw-agregar');
          if (!btn) return true;

          if (!controlDeStock) {          /* trama sin rollos → como siempre */
            btn.disabled = false;
            mostrarStock('');
            return true;
          }

          if (tramaAgotada) {
            btn.disabled = true;
            /* El mensaje dice QUÉ trama está agotada: con varias tramas, un
               "Agotado" a secas no le dice al cliente que pruebe la otra. */
            mostrarStock(
              tramaSeleccionada
                ? 'La trama ' + tramaSeleccionada.nombre + ' está agotada. Prueba con otra trama.'
                : 'Agotado',
              true,
            );
            return false;
          }

          var a = parseInt(sAncho.value, 10);
          var l = parseInt(sAlto.value,  10);
          var cabe = cabeEnCapacidades(a, l, capacidades);

          btn.disabled = !cabe;
          mostrarStock(cabe ? '' : (
            'Esta medida no está disponible en la trama ' +
            (tramaSeleccionada ? tramaSeleccionada.nombre : '') + '. Prueba con otra medida u otra trama.'
          ));
          return cabe;
        }

        /* `tramaRequerida` solo se pone a true si la regla trae al menos una
           trama: una regla SIN tramas no puede quedar bloqueada, igual que una
           trama sin rollos nunca bloquea la venta. */
        function faltaElegirTrama() {
          return tramaRequerida && !tramaSeleccionada;
        }

        /* EL ÚNICO sitio que decide si el botón se habilita.
           🔷 La precedencia se INVIRTIÓ respecto a la versión anterior, y no es
           un detalle de orden: con el stock por trama no HAY stock que evaluar
           hasta que exista una trama elegida, porque la escalera es suya. Así
           que primero la trama, y solo después el stock. */
        function refrescarBoton() {
          var btn = eid('csw-agregar');

          if (faltaElegirTrama()) {
            if (btn) btn.disabled = true;
            bloquearSliders(true);
            mostrarStock('');
            mostrarTramaAviso(true);
            return false;
          }

          bloquearSliders(false);
          mostrarTramaAviso(false);
          return revisarDisponibilidad();
        }

        function mostrarTramaAviso(visible) {
          var el = eid('csw-trama-aviso');
          if (!el) return;
          el.textContent = visible ? 'Selecciona una trama para continuar.' : '';
          el.style.display = visible ? '' : 'none';
        }

        /* Al elegir una trama cambian las TRES cosas: precio, topes y escalera.
           Este es el único sitio donde se aplican, para que no puedan quedar
           desincronizadas entre sí. */
        alCambiarTrama = function () {
          if (tramaSeleccionada) {
            precioPorM2    = tramaSeleccionada.precioPorM2 || 0;
            capacidades    = tramaSeleccionada.capacidades;
            controlDeStock = Array.isArray(capacidades);
            tramaAgotada   = controlDeStock && !hayMaterial(capacidades);

            aplicarTopes(tramaSeleccionada);

            if (!controlDeStock) {
              console.log('[CSW] trama "' + tramaSeleccionada.nombre + '" sin rollos cargados → ' +
                          'sin control de stock. Precio/m² = ' + precioPorM2);
            } else {
              var escalera = [], desde = 1;
              for (var ci = 0; ci < capacidades.length; ci++) {
                escalera.push('ancho pedido ' + desde + '-' + capacidades[ci].anchoCm +
                              ' → rollo ' + capacidades[ci].anchoCm +
                              ', largo ≤ ' + capacidades[ci].largoMaxCm +
                              (capacidades[ci].largoMaxCm <= 0 ? ' (SECO)' : ''));
                desde = capacidades[ci].anchoCm + 1;
              }
              console.log('[CSW] trama "' + tramaSeleccionada.nombre + '" · precio/m² = ' + precioPorM2 +
                          ' · topes ' + sAncho.max + '×' + sAlto.max +
                          ' · escalones: ' + escalera.join('  ·  ') +
                          (tramaAgotada ? '  ·  SIN MATERIAL EN NINGUNO (agotada)' : ''));
            }
          }
          calcular(precioPorM2, waterproofPorM2, waterproofActivo);
          refrescarBoton();
        };

        renderBordes(data.bordes || [], editBorde);
        /* renderTramas va DESPUÉS de definir alCambiarTrama: la auto-selección
           con una sola trama dispara el cambio dentro de esta misma llamada. */
        renderTramas(tramas, editTrama);

        /* Estado inicial. Con tramas y sin elegir, los sliders nacen bloqueados
           y sin precio; sin tramas, todo como siempre. */
        if (sinTramas) {
          calcular(precioPorM2, waterproofPorM2, waterproofActivo);
          bloquearSliders(false);
        }
        refrescarBoton();

        /* Red de seguridad: si algo del tema vuelve a habilitar el botón por su
           cuenta, se re-deshabilita. Solo actúa cuando la compra NO es válida,
           así que nunca pelea con el flujo normal. */
        if ((tramaRequerida || controlDeStock) && window.MutationObserver) {
          var btnRef = eid('csw-agregar');
          if (btnRef) {
            new MutationObserver(function () {
              if (btnRef.disabled) return;   /* no re-entrar: solo actúa si algo lo habilitó */
              var faltaTrama = faltaElegirTrama();
              var a = parseInt(sAncho.value, 10);
              var l = parseInt(sAlto.value,  10);
              var malStock = !faltaTrama && controlDeStock &&
                             (tramaAgotada || !cabeEnCapacidades(a, l, capacidades));
              if (faltaTrama || malStock) {
                console.log('[CSW] el botón fue re-habilitado por fuera → se deshabilita de nuevo',
                            faltaTrama ? '(falta elegir trama)' : '(stock de la trama)');
                btnRef.disabled = true;
              }
            }).observe(btnRef, { attributes: true, attributeFilter: ['disabled'] });
          }
        }

        document.documentElement.classList.add('csw-natives-hidden');
        if (loadingEl)   loadingEl.style.display   = 'none';
        if (containerEl) containerEl.style.display = '';
        root.style.display = '';

        if (enModoEdicion) {
          eid('csw-agregar').textContent = 'Actualizar medidas';
          if (containerEl) containerEl.classList.add('csw-modo-edicion');
        }

        /* Layout nuevo (Fase 3): selectores a la columna izquierda y carrusel a
           ancho completo abajo. Va DESPUÉS de mostrar el widget: si se moviera
           antes, los selectores saldrían de #csw-root (que aún está oculto) y se
           verían un instante sueltos, antes que el resto. */
        reubicarSelectores();
        montarGaleria();

        /* Un solo manejador para los dos sliders, enganchado por TODAS las vías.
           El tema (Merlí, OS 1.0) mueve controles con jQuery y propaga cambios
           con .trigger('change'), que NO despierta un addEventListener nativo.
           Por eso se escucha 'input' + 'change' nativos y, si jQuery está
           presente, también sus eventos. Es idempotente: si llegan dos avisos
           del mismo movimiento, se recalcula lo mismo dos veces y ya. */
        function sincronizarMedidas() {
          eid('csw-ancho-val').textContent = sAncho.value;
          eid('csw-alto-val').textContent  = sAlto.value;
          calcular(precioPorM2, waterproofPorM2, waterproofActivo);
          refrescarBoton();
        }

        sAncho.addEventListener('input',  sincronizarMedidas);
        sAncho.addEventListener('change', sincronizarMedidas);
        sAlto.addEventListener('input',   sincronizarMedidas);
        sAlto.addEventListener('change',  sincronizarMedidas);

        if (window.jQuery) {
          window.jQuery(sAncho).on('input change', sincronizarMedidas);
          window.jQuery(sAlto).on('input change', sincronizarMedidas);
          console.log('[CSW] jQuery detectado → sliders también enganchados por jQuery');
        }
        if (waterproofActivo && eid('csw-waterproof')) {
          eid('csw-waterproof').addEventListener('change', function () {
            var wfLbl = eid('csw-wf-label');
            if (wfLbl) wfLbl.classList.toggle('csw-wf--checked', this.checked);
            calcular(precioPorM2, waterproofPorM2, waterproofActivo);
          });
        }

        eid('csw-agregar').addEventListener('click', function () {
          mostrarError('');

          /* Stock por pliego (Fase 6): red de seguridad. El botón ya está
             deshabilitado en este caso, pero si algo lo reactivara no debe
             colarse una medida imposible. */
          if (!refrescarBoton()) return;

          var anchoN     = parseInt(sAncho.value, 10);
          var altoN      = parseInt(sAlto.value,  10);
          var m2Alfombra = Math.ceil(anchoN / 100) * Math.ceil(altoN / 100);
          var m2Real     = (anchoN / 100) * (altoN / 100);
          var wpChecked  = waterproofActivo && eid('csw-waterproof') && eid('csw-waterproof').checked;

          var precioAlfombra = Math.round(m2Alfombra * precioPorM2);
          var precioWp       = Math.floor(m2Real * waterproofPorM2);
          var bordeStr       = bordeSeleccionado
            ? (bordeSeleccionado.nombre + ' - ' + bordeSeleccionado.tipo)
            : null;
          /* El nombre es el snapshot que ve el taller en el pedido; el id es lo
             que usa el checkout para reservar contra los rollos de ESA trama. */
          var tramaStr       = tramaSeleccionada ? tramaSeleccionada.nombre : null;
          var tramaIdStr     = tramaSeleccionada ? (tramaSeleccionada.id || '') : '';

          try {
            var arr = [];
            var rawArr = localStorage.getItem('csw_pending_orders');
            if (rawArr) {
              var parsedArr = JSON.parse(rawArr);
              if (Array.isArray(parsedArr)) arr = parsedArr;
            }
            var rawViejo = localStorage.getItem('csw_pending_order');
            if (rawViejo) {
              var viejo = JSON.parse(rawViejo);
              if (viejo && typeof viejo === 'object' && !Array.isArray(viejo)) {
                viejo.id = viejo.id || ('legacy_' + Date.now());
                arr = [viejo].concat(arr);
              }
              localStorage.removeItem('csw_pending_order');
            }

            if (enModoEdicion && editId) {
              var reemplazado = false;
              arr = arr.map(function(existing) {
                if (existing.id !== editId) return existing;
                reemplazado = true;
                return {
                  id:               editId,
                  shop:             existing.shop            || shop,
                  reglaId:          reglaId || existing.reglaId || '',
                  ancho:            anchoN,
                  alto:             altoN,
                  waterproof:       !!wpChecked,
                  precio:           precioAlfombra,
                  waterproofPrecio: precioWp,
                  borde:            bordeStr !== null ? bordeStr : (existing.borde || null),
                  trama:            tramaStr !== null ? tramaStr : (existing.trama || null),
                  tramaId:          tramaIdStr || existing.tramaId || '',
                  variantId:        existing.variantId       || root.dataset.variantId    || '',
                  imageUrl:         existing.imageUrl        || root.dataset.imageUrl     || '',
                  productTitle:     existing.productTitle    || (document.querySelector('.product h1') || {}).textContent || '',
                  productHandle:    existing.productHandle   || root.dataset.productHandle || '',
                  createdAt:        existing.createdAt       || Date.now()
                };
              });
              if (!reemplazado) {
                arr.push({
                  id: editId, shop: shop, reglaId: reglaId, ancho: anchoN, alto: altoN,
                  waterproof: !!wpChecked, precio: precioAlfombra, waterproofPrecio: precioWp,
                  borde: bordeStr, trama: tramaStr, tramaId: tramaIdStr,
                  variantId: root.dataset.variantId || '', imageUrl: root.dataset.imageUrl || '',
                  productTitle: (document.querySelector('.product h1') || {}).textContent || '',
                  productHandle: root.dataset.productHandle || '', createdAt: Date.now()
                });
              }
            } else {
              var itemId = shop + '_' + (root.dataset.variantId || '') + '_' + Date.now();
              arr.push({
                id: itemId, shop: shop, reglaId: reglaId, ancho: anchoN, alto: altoN,
                waterproof: !!wpChecked, precio: precioAlfombra, waterproofPrecio: precioWp,
                borde: bordeStr, trama: tramaStr, tramaId: tramaIdStr,
                variantId: root.dataset.variantId || '', imageUrl: root.dataset.imageUrl || '',
                productTitle: (document.querySelector('.product h1') || {}).textContent || '',
                productHandle: root.dataset.productHandle || '', createdAt: Date.now()
              });
            }
            localStorage.setItem('csw_pending_orders', JSON.stringify(arr));
          } catch (e) {
            mostrarError('Error al guardar el pedido. Por favor intenta nuevamente.');
            return;
          }

          if (enModoEdicion) {
            history.replaceState({}, '', window.location.pathname);
            eid('csw-agregar').textContent = 'Agregar a la bolsa';
            if (containerEl) containerEl.classList.remove('csw-modo-edicion');
            enModoEdicion = false;
          }

          if (typeof update_mini_cart === 'function') {
            update_mini_cart(true);
          }
        });
      })
      .catch(function () {
        clearTimeout(safetyTimer);
        var root = document.getElementById('csw-root');
        if (root) root.style.display = 'none';
        mostrarNativos();
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
